{
  "name": "roman-colosseum",
  "version": "1.0.0",
  "description": "A Three.js study of the Roman Colosseum, from present-day ruins to an ancient reconstruction",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run check:i18n && npm run test:i18n && npm run build && node scripts/test.mjs",
    "test:i18n": "node --test tests/i18n.test.js",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "node scripts/check-syntax.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "i18next": "26.4.2",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "vite": "8.0.2"
  }
}
